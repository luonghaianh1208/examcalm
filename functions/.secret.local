# Giá trị secret dành RIÊNG cho Firebase Emulator.
#
# Không có file này, emulator đi hỏi Secret Manager thật cho mọi secret khai
# bằng defineSecret(), nhận 403 rồi thử lại — làm mỗi lần chạy E2E chậm thêm
# hàng chục giây và đổ đầy log lỗi không liên quan.
#
# HAI GIÁ TRỊ DƯỚI ĐÂY LÀ GIẢ và cố ý viết cho ai đọc cũng biết là giả. Emulator
# không gọi ra Internet nên chúng không bao giờ được dùng thật. Secret THẬT nằm
# trong Google Secret Manager, không bao giờ nằm trong repo.
EXAMCALM_AI_API_KEY=EMULATOR-GIA-KHONG-PHAI-KEY-THAT
EXAMCALM_RESEND_API_KEY=EMULATOR-GIA-KHONG-PHAI-KEY-THAT
