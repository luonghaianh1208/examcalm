rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()    { return isSignedIn() && request.auth.token.role == "admin"; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == "student";
      // I3 (final whole-branch review): admin ghi được users/{uid} toàn phần từng vô hại ở
      // Spec #1 (không ai đọc privacySettings.aiOptIn), nhưng Spec #3 biến field này thành công
      // tắc cho phép gửi bài viết cảm xúc của một học sinh vị thành niên tới bên thứ ba — admin
      // KHÔNG được tự ý đổi privacySettings hộ học sinh (chỉ chủ sở hữu mới được, qua nhánh
      // isOwner ở trên/AiConsentSection.tsx). request.resource.data là document SAU khi ghi,
      // nên một update không đụng tới privacySettings tự động thoả điều kiện == (giữ nguyên).
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
                    || (isAdmin() && request.resource.data.privacySettings == resource.data.privacySettings);
      allow delete: if false;
    }

    match /testAttempts/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Đáp án từng câu, tách khỏi testAttempts nhưng dùng CHUNG id (xem
    // src/lib/firestore/attempts.ts). testAttempts cho phép admin đọc để giáo
    // viên biết điểm/mức độ mà can thiệp kịp thời, nhưng đáp án cụ thể từng
    // câu là riêng tư tuyệt đối — chỉ chủ sở hữu mới đọc được.
    match /testAnswers/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /moodLogs/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      // update chỉ được đổi field khác — userId của document SAU khi ghi phải giữ
      // nguyên userId TRƯỚC khi ghi, nếu không kẻ tấn công có thể tạo doc bằng uid
      // của chính mình rồi update lại userId thành uid nạn nhân để "cấy" nội dung
      // vào nhật ký của người khác.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid}/favorites/{resourceId} {
      allow read, write: if isOwner(uid);
    }

    match /resources/{id} {
      allow read: if (resource.data.status == "published" &&
                      (resource.data.visibility == "public" || isSignedIn()))
                  || isAdmin();
      allow write: if isAdmin();
    }

    match /testDefinitions/{id} {
      allow read:  if resource.data.status == "published" || isAdmin();
      // Ở production, KHÔNG cho publish nội dung mẫu chưa thẩm định.
      allow write: if isAdmin() &&
                   !(request.resource.data.status == "published" &&
                     request.resource.data.isSampleContent == true);
    }

    match /auditLogs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /cbtModules/{id} {
      allow read:  if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /cbtSessions/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      // Admin KHÔNG đọc được — nội dung học sinh viết về suy nghĩ tiêu cực của
      // mình còn riêng tư hơn điểm số. Cố ý khác testAttempts.
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // aiJournalOutputs: phản chiếu (reflection) do AI sinh ra dựa trên ghi chú
    // riêng tư của học sinh (moodLogs/cbtSessions). Vì gắn liền với nội dung
    // private đó, admin KHÔNG được đọc — cùng lý do admin không đọc được
    // moodLogs. Chỉ Cloud Function (Admin SDK, bỏ qua rules) mới được tạo
    // document; client không bao giờ được create trực tiếp.
    match /aiJournalOutputs/{id} {
      allow create: if false;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // update chỉ để học sinh gắn phản hồi (userFeedback) của mình. Dùng
      // diff().affectedKeys().hasOnly([...]) để KHOÁ TOÀN BỘ field khác trong
      // một lần — không chỉ pin userId/reflectionText mà bỏ ngỏ các field còn
      // lại (catStoryText, journalPrompt, promptTemplateId, promptVersion,
      // providerLabel, model, createdAt, hay field lạ tự thêm vào). Nếu chỉ
      // pin từng field như bài học moodLogs.userId thì các field AI-generated
      // khác vẫn bị ghi đè được — bài học rút ra sau round review đầu.
      // userFeedback chấp nhận cả null — đó là trạng thái "chưa đánh giá" ban
      // đầu trong aiJournalOutputSchema, nên học sinh phải rút lại đánh giá
      // được (quay về null), không thể kẹt vĩnh viễn giữa helpful/not_helpful.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userFeedback"])
                    && (request.resource.data.userFeedback == null
                        || request.resource.data.userFeedback in ["helpful", "not_helpful"]);
    }

    // aiUsage: sổ đếm quota gọi AI. Học sinh đọc được thì không sao nhưng
    // không cần thiết cho tính năng nào hiện tại, còn ghi được thì quota vô
    // nghĩa — khoá tuyệt đối từ client, chỉ Cloud Function (Admin SDK) ghi.
    match /aiUsage/{id} {
      allow read, write: if false;
    }

    // systemConfig/aiPublic: Firestore đánh giá MỌI khối match khớp path và
    // hợp (OR) các quyền lại — thứ tự khai báo không ảnh hưởng hành vi. Khối
    // hẹp này chỉ nới quyền đọc cho đúng một document id (aiPublic, chứa tên
    // nhà cung cấp AI để hiển thị ở màn hình xin đồng ý trước khi bật tính
    // năng AI); mọi id khác (vd. aiConfig chứa baseUrl, quota, rate limit)
    // không khớp path này nên chỉ chịu rule admin-only ở khối chung bên dưới.
    // I4 (final whole-branch review): saveAiConfig() (Cloud Function, Admin SDK) ghi aiConfig
    // và aiPublic ATOMIC, nhưng rules trước đây vẫn cho phép ghi RIÊNG LẺ document này qua client
    // SDK — rules test của chính dự án từng chứng minh điều đó (một admin gọi thẳng setDoc() từ
    // DevTools). providerLabel ghi vào đây PHẢI khớp providerLabel hiện có ở aiConfig, nếu không
    // màn hình đồng ý (AiConsentSection.tsx) có thể nêu sai tên nơi nhận dữ liệu (R5, spec §3.3).
    // Ràng buộc này KHÔNG áp dụng cho Cloud Function saveAiConfig — Admin SDK bỏ qua Security
    // Rules hoàn toàn — nó chỉ đóng đường ghi trực tiếp từ client. aiConfig chưa tồn tại (chưa
    // cấu hình lần nào) coi providerLabel của nó là rỗng, khớp sentinel "chưa cấu hình" của
    // DEFAULT_AI_CONFIG — get() sẽ lỗi nếu gọi trên document không tồn tại nên phải exists()
    // trước.
    match /systemConfig/aiPublic {
      allow read: if isSignedIn();
      allow write: if isAdmin() &&
        request.resource.data.providerLabel ==
          (exists(/databases/$(database)/documents/systemConfig/aiConfig)
            ? get(/databases/$(database)/documents/systemConfig/aiConfig).data.providerLabel
            : "");
    }

    // Residual 1 (re-review vòng cuối, final whole-branch review): I5 (audit log cho
    // saveAiConfig) chỉ có ý nghĩa nếu Cloud Function saveAiConfig (Admin SDK) là đường DUY
    // NHẤT ghi được document này. Trước fix, khối wildcard bên dưới vẫn cho admin setDoc()
    // thẳng aiConfig từ client (DevTools) — đổi baseUrl trỏ về server riêng của admin đó, nhận
    // nguyên văn ghi chú của mọi học sinh đã opt-in, và KHÔNG để lại một dòng auditLogs nào.
    // Đường đó cũng làm hở một chiều còn lại của I4: rule cũ chỉ khoá aiPublic lệch khỏi
    // aiConfig, không khoá chiều ngược — aiConfig có thể tự đổi rời khỏi aiPublic. Từ khi
    // saveAiConfig() đã là callable dùng Admin SDK (bỏ qua rules), không còn đường hợp lệ nào
    // cần client ghi trực tiếp document này nữa — khoá hẳn allow write: if false. Đọc vẫn admin-
    // only (AiConfigEditor.tsx đọc trực tiếp qua getAiConfig() để hiện form).
    match /systemConfig/aiConfig {
      allow read: if isAdmin();
      allow write: if false;
    }

    // I4 fix, phần 2: Firestore hợp (OR) MỌI khối match khớp cùng path — khối wildcard này
    // cũng khớp path "systemConfig/aiPublic" VÀ "systemConfig/aiConfig", nên nếu không loại trừ
    // tường minh cả hai, quyền admin ghi tuỳ ý ở đây sẽ ĐÈ LÊN ràng buộc/khoá ở hai khối hẹp
    // phía trên (Firestore OR mọi khối khớp cùng path — khối LỎNG hơn thắng), khiến cả hai vô
    // tác dụng dù đọc code tưởng đã chặn.
    match /systemConfig/{id} {
      allow read, write: if isAdmin() && id != "aiPublic" && id != "aiConfig";
    }

    match /promptTemplates/{id} {
      allow read, write: if isAdmin();
    }

    // aiSafetyLog: Cloud Function ghi vào đây (qua Admin SDK, bỏ qua rules)
    // khi model sinh ngôn ngữ chẩn đoán bị chặn, để admin sửa lại prompt. CHỈ
    // lưu metadata (triggeredKeyword, model, promptTemplateId, createdAt) —
    // TUYỆT ĐỐI không lưu nội dung output bị chặn hay uid học sinh: output đó
    // là phản chiếu về ghi chú riêng tư của học sinh, nếu admin đọc được sẽ mở
    // lại đúng lỗ hổng mà lệnh cấm admin đọc aiJournalOutputs ở trên đang đóng.
    match /aiSafetyLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // chatSessions: phiên chat của học sinh với AI (Spec #4, design §4/§5).
    // Học sinh tạo/đọc/xoá được phiên của mình; admin KHÔNG đọc được — nội
    // dung chat viết trực tiếp bằng lời, nhạy cảm hơn cả moodLogs/cbtSessions.
    // update bị khoá tuyệt đối từ client — chỉ Cloud Function (Admin SDK) mới
    // cập nhật lastMessageAt/messageCount khi có tin nhắn mới.
    match /chatSessions/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // chatMessages: từng tin nhắn trong phiên chat. Admin KHÔNG đọc được,
    // cùng lý do chatSessions. create BỊ TỪ CHỐI KỂ CẢ CHÍNH CHỦ — ràng buộc
    // quan trọng nhất của cả spec: MỌI tin nhắn phải đi qua Cloud Function
    // callable, nơi chạy lớp phát hiện khủng hoảng (từ khoá + model) TRƯỚC khi
    // ghi vào Firestore. Nếu client ghi trực tiếp được, tin nhắn có thể lọt
    // qua bộ phát hiện đó hoàn toàn. update cũng khoá vì tin nhắn không được
    // sửa sau khi gửi.
    match /chatMessages/{id} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }

    // crisisAlerts: hồ sơ cảnh báo khi phát hiện dấu hiệu khủng hoảng, để
    // admin can thiệp. Học sinh KHÔNG đọc được — KỂ CẢ cảnh báo về chính mình
    // (ruling C4, design §3.4/§5): em đã được báo trực tiếp ngay trong đoạn
    // chat lúc đó rồi, đọc thêm bản ghi quản trị không cho thông tin gì mới,
    // còn một bản ghi đọc được sẽ lộ NGƯỠNG phát hiện cho em tìm cách né tránh
    // lần sau. Không ai create/delete được từ client — document chỉ do Cloud
    // Function (Admin SDK) tạo khi phát hiện khủng hoảng; delete cố ý khoá
    // luôn cho CHÍNH học sinh — đây là hồ sơ an toàn, không phải nội dung
    // riêng tư của em, để em tự xoá được thì tương đương xoá bằng chứng nên
    // thầy cô không bao giờ biết em đã gặp nguy. admin update CHỈ được đổi
    // handledBy + handledAt — dùng diff().affectedKeys().hasOnly([...]) để
    // khoá TOÀN BỘ field còn lại (userId, severity, triggeredBy, createdAt)
    // trong MỘT LẦN, không ghim từng field — bài học Critical của Spec #3
    // Task 2 (ghim 2/11 field, bỏ ngỏ 9 field còn lại). handledBy còn phải
    // khớp đúng uid của admin đang ghi — hồ sơ này chỉ có giá trị nếu ghi
    // đúng AI thật sự đã nhận xử lý; không ràng buộc thì một admin có thể gán
    // handledBy cho đồng nghiệp khác (đổ trách nhiệm) hoặc ngược lại.
    match /crisisAlerts/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["handledBy", "handledAt"])
                    && request.resource.data.handledBy == request.auth.uid;
      allow create, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
