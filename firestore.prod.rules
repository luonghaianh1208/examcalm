rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()    { return isSignedIn() && request.auth.token.role == "admin"; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }

    match /users/{uid} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == "student";
      // I3 (final whole-branch review): admin ghi được users/{uid} toàn phần từng vô hại ở
      // Spec #1 (không ai đọc privacySettings.aiOptIn), nhưng Spec #3 biến field này thành công
      // tắc cho phép gửi bài viết cảm xúc của một học sinh vị thành niên tới bên thứ ba — admin
      // KHÔNG được tự ý đổi privacySettings hộ học sinh (chỉ chủ sở hữu mới được, qua nhánh
      // isOwner ở trên/AiConsentSection.tsx). request.resource.data là document SAU khi ghi,
      // nên một update không đụng tới privacySettings tự động thoả điều kiện == (giữ nguyên).
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
                    || (isAdmin() && request.resource.data.privacySettings == resource.data.privacySettings);
      allow delete: if false;
    }

    match /testAttempts/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read:   if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // Đáp án từng câu, tách khỏi testAttempts nhưng dùng CHUNG id (xem
    // src/lib/firestore/attempts.ts). testAttempts cho phép admin đọc để giáo
    // viên biết điểm/mức độ mà can thiệp kịp thời, nhưng đáp án cụ thể từng
    // câu là riêng tư tuyệt đối — chỉ chủ sở hữu mới đọc được.
    match /testAnswers/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /moodLogs/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      // update chỉ được đổi field khác — userId của document SAU khi ghi phải giữ
      // nguyên userId TRƯỚC khi ghi, nếu không kẻ tấn công có thể tạo doc bằng uid
      // của chính mình rồi update lại userId thành uid nạn nhân để "cấy" nội dung
      // vào nhật ký của người khác.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /users/{uid}/favorites/{resourceId} {
      allow read, write: if isOwner(uid);
    }

    match /resources/{id} {
      allow read: if (resource.data.status == "published" &&
                      (resource.data.visibility == "public" || isSignedIn()))
                  || isAdmin();
      allow write: if isAdmin();
    }

    match /testDefinitions/{id} {
      allow read:  if resource.data.status == "published" || isAdmin();
      // Ở production, KHÔNG cho publish nội dung mẫu chưa thẩm định.
      allow write: if isAdmin() &&
                   !(request.resource.data.status == "published" &&
                     request.resource.data.isSampleContent == true);
    }

    match /auditLogs/{id} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    match /cbtModules/{id} {
      allow read:  if resource.data.status == "published" || isAdmin();
      allow write: if isAdmin();
    }

    match /cbtSessions/{id} {
      allow create: if isVerified() && request.resource.data.userId == request.auth.uid;
      // Admin KHÔNG đọc được — nội dung học sinh viết về suy nghĩ tiêu cực của
      // mình còn riêng tư hơn điểm số. Cố ý khác testAttempts.
      allow read:   if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // aiJournalOutputs: phản chiếu (reflection) do AI sinh ra dựa trên ghi chú
    // riêng tư của học sinh (moodLogs/cbtSessions). Vì gắn liền với nội dung
    // private đó, admin KHÔNG được đọc — cùng lý do admin không đọc được
    // moodLogs. Chỉ Cloud Function (Admin SDK, bỏ qua rules) mới được tạo
    // document; client không bao giờ được create trực tiếp.
    match /aiJournalOutputs/{id} {
      allow create: if false;
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      // update chỉ để học sinh gắn phản hồi (userFeedback) của mình. Dùng
      // diff().affectedKeys().hasOnly([...]) để KHOÁ TOÀN BỘ field khác trong
      // một lần — không chỉ pin userId/reflectionText mà bỏ ngỏ các field còn
      // lại (catStoryText, journalPrompt, promptTemplateId, promptVersion,
      // providerLabel, model, createdAt, hay field lạ tự thêm vào). Nếu chỉ
      // pin từng field như bài học moodLogs.userId thì các field AI-generated
      // khác vẫn bị ghi đè được — bài học rút ra sau round review đầu.
      // userFeedback chấp nhận cả null — đó là trạng thái "chưa đánh giá" ban
      // đầu trong aiJournalOutputSchema, nên học sinh phải rút lại đánh giá
      // được (quay về null), không thể kẹt vĩnh viễn giữa helpful/not_helpful.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["userFeedback"])
                    && (request.resource.data.userFeedback == null
                        || request.resource.data.userFeedback in ["helpful", "not_helpful"]);
    }

    // aiUsage: sổ đếm quota gọi AI. Học sinh đọc được thì không sao nhưng
    // không cần thiết cho tính năng nào hiện tại, còn ghi được thì quota vô
    // nghĩa — khoá tuyệt đối từ client, chỉ Cloud Function (Admin SDK) ghi.
    match /aiUsage/{id} {
      allow read, write: if false;
    }

    // systemConfig/aiPublic: Firestore đánh giá MỌI khối match khớp path và
    // hợp (OR) các quyền lại — thứ tự khai báo không ảnh hưởng hành vi. Khối
    // hẹp này chỉ nới quyền đọc cho đúng một document id (aiPublic, chứa tên
    // nhà cung cấp AI để hiển thị ở màn hình xin đồng ý trước khi bật tính
    // năng AI); mọi id khác (vd. aiConfig chứa baseUrl, quota, rate limit)
    // không khớp path này nên chỉ chịu rule admin-only ở khối chung bên dưới.
    match /systemConfig/aiPublic {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /systemConfig/{id} {
      allow read, write: if isAdmin();
    }

    match /promptTemplates/{id} {
      allow read, write: if isAdmin();
    }

    // aiSafetyLog: Cloud Function ghi vào đây (qua Admin SDK, bỏ qua rules)
    // khi model sinh ngôn ngữ chẩn đoán bị chặn, để admin sửa lại prompt. CHỈ
    // lưu metadata (triggeredKeyword, model, promptTemplateId, createdAt) —
    // TUYỆT ĐỐI không lưu nội dung output bị chặn hay uid học sinh: output đó
    // là phản chiếu về ghi chú riêng tư của học sinh, nếu admin đọc được sẽ mở
    // lại đúng lỗ hổng mà lệnh cấm admin đọc aiJournalOutputs ở trên đang đóng.
    match /aiSafetyLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
